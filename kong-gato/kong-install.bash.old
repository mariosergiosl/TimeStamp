#/bin/bash
helm repo add kong https://charts.konghq.com
helm repo update

kubectl create namespace kong

# COM SSL
#openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout tls.key -out tls.crt -subj "/CN=kong-manager.local"
# kubectl create secret tls kong-manager-tls --cert=tls.crt --key=tls.key

# helm install kong kong/kong --set dbless=false --set postgresql.enabled=false --set cassandra.enabled=true --set cassandra.contact_points[0]=cassandra-0.cassandra.default.svc.cluster.local --set cassandra.keyspace=kong --set admin.enabled=true --set proxy.enabled=true --set ingressController.enabled=true --set ingressController.ingressClassName=nginx 


# SEM SSL
helm install kong kong/kong \
  --set dbless=false \
  --set postgresql.enabled=false \
  --set cassandra.enabled=true \
  --set cassandra.contact_points[0]=cassandra-0.cassandra.default.svc.cluster.local \
  --set cassandra.keyspace=kong \
  --set admin.enabled=true \
  --set admin.tls.enabled=false \
  --set proxy.enabled=true \
  --set ingressController.enabled=true \
  --set ingressController.ingressClassName=nginx

# USANDO VALUES
helm install kong kong/kong --namespace kong --create-namespace -f kong-values.yaml

helm install kong kong/kong \
  --set postgresql.enabled=false \
  --set dbless=false \
  --set cassandra.enabled=true \
  --set cassandra.contact_points[0]=cassandra-0.cassandra.default.svc.cluster.local \
  --set cassandra.keyspace=kong \
  --set ingressController.enabled=false \
  --set ingress.enabled=true \
  --set ingress.annotations."kubernetes\.io/ingress\.class"=nginx \
  --set ingress.hosts[0]=192.168.1.4 \
  --set ingress.paths[0]=/ \
  --set ingress.paths[1]=/kong-manager \
  --set admin.ssl=false \
  --set admin.gui_url=http://192.168.1.4:31667 \
  --set admin.http.enabled=true \
  --set admin.tls.enabled=false \
  --set admin.service.type=NodePort \
  --set admin.service.http.nodePort=31667 \
  --set admin.username=admin \
  --set admin.password=admin \
  --set pod.hostNetwork=true \
  --set pod.securityContext.runAsUser=0 \
  --set pod.securityContext.runAsGroup=0

